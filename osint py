import phonenumbers
from phonenumbers import geocoder, carrier, timezone
import socket, re, webbrowser, requests

R = "\033[91m"
G = "\033[92m"
Y = "\033[93m"
C = "\033[96m"
W = "\033[97m"

print(R + """
BHACKSH OSINT V6.0 EXTREME by PRANAY
We Audit, We Protect - EST 2026
Bhandara Cyber Squad
""" + W)
print(G + " [ 4-in-1 EXTREME Tool: Phone | Email | IP | Insta ]" + W)

def phone_osint():
    num = input(Y + "\nPhone Number (+91 ke sath): " + W)
    try:
        p = phonenumbers.parse(num)
        if not phonenumbers.is_valid_number(p):
            print(R + " Galat Number! Format +9198xxxxxx10" + W)
            return
        print(G + f" Valid: {phonenumbers.is_valid_number(p)}" + W)
        print(G + f" Operator: {carrier.name_for_number(p, 'en')}" + W)
        print(G + f" Location/Circle: {geocoder.description_for_number(p, 'en')}" + W)
        print(G + f" Timezone: {timezone.time_zones_for_number(p)}" + W)
        print(G + f" Country Code: +{p.country_code}" + W)
        print(C + f" Link: https://truecaller.com/search/in/{num}" + W)
        print(C + f" Scam Check: https://www.ipqualityscore.com/phone-number-validator/{num}" + W)
    except:
        print(R + " Galat Number!" + W)

def email_osint():
    email = input(Y + "\nEmail daal: " + W)
    if re.match(r"[^@]+@[^@]+\.[^@]+", email):
        print(G + f" Valid: {email}" + W)
        print(G + f" Domain: {email.split('@')[1]}" + W)
        print(G + f" Gmail Link: https://mail.google.com/mail/u/0/#search/{email}" + W)
        print(C + f" Leak Check: https://haveibeenpwned.com/account/{email}" + W)
    else:
        print(R + " Invalid Email" + W)

def ip_osint():
    ip = input(Y + "\nIP daal: " + W)
    try:
        try:
            host = socket.gethostbyaddr(ip)[0]
        except:
            host = "Not Found"
        print(G + f" IP: {ip}" + W)
        print(G + f" Host: {host}" + W)
        try:
            r = requests.get(f"https://ipapi.co/{ip}/json/", timeout=5).json()
            lat = r.get('latitude')
            lon = r.get('longitude')
            print(G + f" City: {r.get('city')}, {r.get('region')}, {r.get('country_name')}" + W)
            print(G + f" ISP: {r.get('org')}" + W)
            print(G + f" ASN: {r.get('asn')}" + W)
            print(C + f" MAP: https://www.google.com/maps/search/?api=1&query={lat},{lon}" + W)
            print(C + f" Report: https://whatismyipaddress.com/ip/{ip}" + W)
        except:
            print(Y + " IP API limit - 1 min baad try kar" + W)
        print(C + f" Full Report: https://ipinfo.io/{ip}" + W)
    except:
        print(R + " Invalid IP" + W)

def insta_osint():
    user = input(Y + "\nInsta Username: " + W)
    user = user.replace("@", "").strip()
    print(G + f" Username: {user}" + W)
    print(C + f" Profile: https://instagram.com/{user}" + W)
    print(C + f" Google Dork: https://www.google.com/search?q=site:instagram.com+{user}" + W)
    q = input(Y + " Browser me kholu? y/n: " + W)
    if q.lower() == 'y':
        webbrowser.open(f"https://instagram.com/{user}")

while True:
    print(Y + "\n[1] Phone [2] Email [3] IP [4] Insta [5] Exit" + W)
    c = input("Option: ")
    if c == '1': phone_osint()
    elif c == '2': email_osint()
    elif c == '3': ip_osint()
    elif c == '4': insta_osint()
    elif c == '5': break
    else: print("Sahi option daal!")
