import phonenumbers
from phonenumbers import geocoder, carrier, timezone
import socket, re, webbrowser

print("PRANAY GHOST OSINT V4.0 ULTRA")
print("Bhandara Cyber Squad - 4 in 1 Tool")

def phone_osint():
    num = input("Phone Number (+91 ke saath): ")
    try:
        p = phonenumbers.parse(num)
        print("Valid:", phonenumbers.is_valid_number(p))
        print("Operator:", carrier.name_for_number(p, 'en'))
        print("Location:", geocoder.description_for_number(p, 'en'))
        print("Timezone:", timezone.time_zones_for_number(p))
        print("Link: truecaller.com/search/in/" + num)
    except:
        print("Galat Number!")

def email_osint():
    email = input("Email daal: ")
    if re.match(r"[^@]+@[^@]+\.[^@]+", email):
        domain = email.split('@')[1]
        print("Valid:", email)
        print("Domain:", domain)
    else:
        print("Invalid Email")

def ip_osint():
    ip = input("IP daal: ")
    try:
        host = socket.gethostbyaddr(ip)[0]
        print("IP:", ip, "Host:", host)
        print("ipinfo.io/" + ip)
    except:
        print("Invalid IP")

def insta_osint():
    user = input("Insta Username daal: ")
    user = user.replace("@", "")
    print("Username:", user)
    print("Profile: https://instagram.com/" + user)
    print("Google: https://www.google.com/search?q=site:instagram.com+" + user)
    q = input("Browser me kholun? y/n: ")
    if q.lower() == 'y':
        webbrowser.open("https://instagram.com/" + user)

while True:
    print("\n[1]Phone [2]Email [3]IP [4]Insta [5]Exit")
    c = input("Option chun: ")
    if c == '1': phone_osint()
    elif c == '2': email_osint()
    elif c == '3': ip_osint()
    elif c == '4': insta_osint()
    elif c == '5': break
    else: print("Sahi option daal!")
